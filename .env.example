# Copy to .env. Everything is optional except one way to sign in (A or B).

# --- Server -----------------------------------------------------------------
PORT=8787
# 127.0.0.1 keeps the server private to this machine. Use 0.0.0.0 behind a reverse proxy or in Docker.
HOST=127.0.0.1
# The public URL users open. Must match the OAuth callback and be https in production.
# API requests for any other hostname are refused (ALLOWED_ORIGINS adds more, comma-separated).
BASE_URL=http://localhost:8787
# Where the SQLite database and the generated secret key live. Back this folder up.
DATA_DIR=./data
# Encrypts GitHub tokens at rest. If unset, a key is generated into DATA_DIR/secret.key.
# APP_SECRET=
# Number of reverse proxies in front of the server (usually 1). The client address is then read
# from X-Forwarded-For. Leave unset when the server is reached directly.
# TRUST_PROXY=1
# Database snapshots: written to DATA_DIR/backups, the newest BACKUP_KEEP are kept. 0 hours = off.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
# BACKUP_DIR=

# --- A) Single-user mode (simplest for self-hosting) -------------------------
# A GitHub token for your own account. Classic token: scope "repo".
# Fine-grained token: Repository permissions "Administration: read" and "Metadata: read"
# (plus "Contents: read" for release downloads). With the GitHub CLI: gh auth token
# GITHUB_TOKEN=
# Required as soon as HOST or BASE_URL is not local: the password for the sign-in page.
# Mode A is switched off when GITHUB_CLIENT_ID or STRIPE_SECRET_KEY is set.
# APP_PASSWORD=

# --- B) "Sign in with GitHub" (multi-user) -----------------------------------
# From an OAuth App (https://github.com/settings/developers) or a GitHub App.
# Callback URL: <BASE_URL>/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAuth App scopes. "repo" is what GitHub requires for private repos and for traffic data.
# Use "read:user public_repo" to limit the instance to public repositories.
# GITHUB_SCOPES=read:user repo
# Only for a GitHub App: its URL slug, so the UI can link to "Choose repositories".
# App permissions needed: Administration (read), Metadata (read), Contents (read).
# GITHUB_APP_SLUG=

# --- Codeberg -------------------------------------------------------------------
# Public repositories on codeberg.org can be followed (stars, forks, issues, releases, commits;
# Codeberg records no traffic). That works without any setup. A token is optional: it only
# identifies this instance to Codeberg. Create one under Settings > Applications with the
# read:repository scope.
# CODEBERG_TOKEN=

# --- Sync ---------------------------------------------------------------------
# Hours between automatic syncs when billing is off. GitHub keeps 14 days of traffic,
# so anything up to a few days is safe; 6 keeps charts fresh.
# SYNC_INTERVAL_HOURS=6
# Accounts synced at the same time on a multi-user instance.
# SYNC_ACCOUNTS=3

# --- Demo account -------------------------------------------------------------
# Adds a read-only account with sample data and a "Try the live demo" button.
# DEMO=1

# --- Hosted mode: plans and Stripe billing ------------------------------------
# Billing switches on when STRIPE_SECRET_KEY is set. Without it every account has all features.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=            # endpoint: <BASE_URL>/api/billing/webhook
# STRIPE_PRICE_MONTHLY=price_...    # events: checkout.session.completed, customer.subscription.*
# STRIPE_PRICE_YEARLY=price_...
# PRICE_DISPLAY_MONTHLY=$3
# PRICE_DISPLAY_YEARLY=$29
# FREE_TRACKED_REPOS=3
# FREE_FOLLOWED_REPOS=10
# FREE_SYNC_INTERVAL_HOURS=24
# PRO_FOLLOWED_REPOS=100
# PRO_SYNC_INTERVAL_HOURS=6
# GitHub logins or numeric user ids that get every feature for free on a hosted instance (you),
# and the Admin page with accounts and visit numbers.
# ADMIN_LOGINS=

# --- Operator: imprint, privacy and terms pages -------------------------------
# With a name and an address the instance shows /imprint, /privacy and /terms.
# OPERATOR_NAME=Ada Example
# OPERATOR_ADDRESS=Main Street 1; 12345 Sampletown; Germany
# OPERATOR_EMAIL=hello@example.com
# Named on the privacy page as the company running the server.
# OPERATOR_HOSTING=Example Hosting GmbH, Germany
# Extra footer links.
# OPERATOR_LINKS=Blog=https://example.com/blog, Mastodon=https://example.social/@ada
