{
  "name": "repoeasy",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Lifetime GitHub repo analytics: archive traffic past the 14-day window, track stars/forks/downloads, follow any public repo.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "biome lint --error-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-shape": "^3.2.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
